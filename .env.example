# Copy this file to .env.local (same folder as package.json) and fill in what you have.
# .env.local is git-ignored — never commit real keys.

# SQLite file for the demo. Postgres support: see ASSUMPTIONS.md (A-03).
DATABASE_URL=file:./data/svara.db

# Signs session cookies and call transcripts. Any long random string.
# REQUIRED for `npm run build && npm start`.
SESSION_SECRET=replace-with-a-long-random-string

# ── Live call demo: the AI's brain ──
# Free key from https://aistudio.google.com/apikey
# Without it, calls follow the fixed script.
GEMINI_API_KEY=
# Optional. Change if Google retires this model name.
GEMINI_MODEL=gemini-2.5-flash

# ── Live call demo: the AI's voice ──
# Key from https://elevenlabs.io → Profile → API keys (enable Text to Speech).
# Without it (or when free credits run out), the browser's own voice is used.
ELEVENLABS_API_KEY=
# Optional: a voice ID from the ElevenLabs Voices page (an Indian-English voice works best).
ELEVENLABS_VOICE_ID=
# eleven_flash_v2_5 is fast and uses fewer credits.
ELEVENLABS_MODEL=eleven_flash_v2_5

# Optional LLM extraction for the need profile (falls back to rules).
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
