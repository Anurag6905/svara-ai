# Copy to .env.local. All values are optional for the local demo.

# SQLite file for the demo. Postgres support: see ASSUMPTIONS.md (A-03).
DATABASE_URL=file:./data/svara.db

# Signs mock-auth session cookies. REQUIRED for any non-local deployment.
SESSION_SECRET=replace-with-a-long-random-string

# Optional LLM provider for extraction (Milestone 5). Leave empty to use the
# deterministic mock, which keeps the demo fully functional offline.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
